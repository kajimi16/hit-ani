# 复制为 .env 后填写。切勿把真实密钥提交到版本库。

# PostgreSQL 连接串
DATABASE_URL="postgresql://hitani:hitani@localhost:55432/hitani?schema=public"

# 会话 Cookie 的 HMAC 密钥，生产环境必须替换：
#   openssl rand -base64 48
SESSION_SECRET=""

# Cookie 的 Secure 标志。**留空即可** —— 默认按真实连接协议判定
# （反代置了 x-forwarded-proto=https 才加 Secure）。
#
# ⚠️ 不要用 NODE_ENV 推断：容器里它是 production，于是 Cookie 带 Secure，
# 而浏览器拒绝在明文 HTTP 的非 localhost 源上存储它 —— 从局域网 IP 访问时
# 登录会静默失效（接口 200、Cookie 被丢弃）。这是实际踩过的坑。
#
# 仅在需要强制时设置：1 = 总是加 Secure；0 = 总是不加。
SESSION_COOKIE_SECURE=""

# Bangumi OAuth2 应用凭据
# 申请：https://bgm.tv/dev/app/create
# 回调地址填 http://<你的域名>/api/auth/bgm/callback
BGM_CLIENT_ID=""
BGM_CLIENT_SECRET=""
BGM_USER_AGENT="hit-ani/0.1 (https://github.com/your-org/hit-ani)"

# QQ 互联 应用凭据
# 申请：https://connect.qq.com
# 回调地址填 http://<你的域名>/api/auth/qq/callback
QQ_APP_ID=""
QQ_APP_KEY=""

# 媒体源抓取：仅当**本地开发机**跑着 Clash/Surge 这类 fake-IP 代理时设为 1。
# 生产环境务必留空 —— 开启会削弱对 DNS 重绑定的防护。
MEDIA_SSRF_TRUST_FAKE_IP=""

# dandanplay（公共弹幕源）—— 「大量弹幕」的来源，聚合 B站/AcFun/巴哈
# 申请：https://dev.dandanplay.com
#   注册账号 → 完善开发者资料 → 邮件验证 → 创建应用并提交审核（人工审核）
#   审核通过后得到 1 个 AppId + 2 个 AppSecret（主密钥与备用密钥）
DANDANPLAY_APP_ID=""
DANDANPLAY_APP_SECRET=""
# 鉴权模式：credential（默认，服务器端推荐，只需 AppId+AppSecret）
#           signature（多一次哈希，适合客户端；服务器端无必要）
DANDANPLAY_AUTH_MODE=""

# 管理员邮箱（逗号分隔）。管理员可配置全站共享的抓取源。
#
# ⚠️ **不要填种子账号**（如 alice@hit.edu.cn）—— 它的密码写在公开仓库里，
# 填了等于开放一个任何人都能登录的管理员入口。
# 请填你自己的学校邮箱。留空则无人是管理员（抓取源将无人能配置）。
ADMIN_EMAILS=""

# 弹幕全局屏蔽词（逗号分隔）。**上线前必须配置** —— 否则违规内容无人可挡。
DANMAKU_BLOCKED_WORDS=""

# ---------------------------------------------------------------- 部署（Docker Compose）
# 数据库凭据。只用于容器之间，不会暴露到宿主机。
# 生产环境务必改成强密码 —— 它是数据库的唯一防线。
POSTGRES_USER="hitani"
POSTGRES_PASSWORD=""
POSTGRES_DB="hitani"
# 对外暴露的 Web 端口
WEB_PORT=3100
# 数据库在宿主机上的回环端口（仅 127.0.0.1 可连，供冒烟测试清理用）
POSTGRES_HOST_PORT=55433

# 冒烟测试清理用的数据库地址（须与目标实例的库一致）。
# 不设时清理会连 DATABASE_URL —— 若目标跑在容器里，那会连错库、留下测试数据。
# 用 `npm run smoke` 对容器时填：
# SMOKE_DATABASE_URL="postgresql://hitani:密码@127.0.0.1:55433/hitani?schema=public"
SMOKE_DATABASE_URL=""

# ---------------------------------------------------------------- 本地媒体库（Jellyfin，可选）
# 媒体文件目录，**只读**挂载给 Jellyfin。留空则用仓库内的相对路径占位。
MEDIA_LIBRARY_PATH=""
# Jellyfin 对外端口（学生浏览器直连它取流）
JELLYFIN_PORT=3103
# Jellyfin 生成客户端 URL 用的地址 —— 必须是学生能访问到的地址，
# 否则播放地址会指向容器内部、学生连不上。
JELLYFIN_PUBLIC_URL=""

# ---------------------------------------------------------------- 弹幕 WebSocket 网关
# 网关是独立进程（长连接 + 常驻内存广播，Serverless 跑不了），
# 因此需要单独一个端口供浏览器直连。
DANMAKU_GATEWAY_PORT=3102
NEXT_PUBLIC_DANMAKU_WS_PORT=3102

# 浏览器侧连接网关的完整地址。
# **留空即可**：默认按页面主机名自动推导（用 IP 访问就连那个 IP，用域名就连域名）。
# 只有反向代理把 WS 挂在别的域名/路径下时才需要显式设置。
NEXT_PUBLIC_DANMAKU_WS_URL=""

# ---------------------------------------------------------------- 上游写入硬闸（运维级）
#
# ⚠️ 这**不是**用户开关。用户是否同步由设置页的「同步到 Bangumi」决定
#    （`User.mirrorToBgm`，**默认关闭**）。
#
# 这一个环境变量是**运维级硬闸**：设成 "0" 时，无论用户怎么设置，
# 服务端一律拒绝写 Bangumi。用于整批跑写库测试、或发生污染时的紧急刹车。
#
# 判定顺序：本硬闸 → 测试账号模式 → 用户偏好。
# 只有恰好为字符串 "0" 才生效（"false" / "no" 都不算）。
BGM_MIRROR_ENABLED="1"

# ---------------------------------------------------------------- 邮件发送（注册邮箱验证码）
#
# ⚠️ 注册**强制**要求邮箱验证码，因此这两组配置**必须配一个**，否则无法注册。
#    两者都没配时，「发送验证码」接口会返回 503 并说明原因（不会静默放行）。
#
# 传输选择：配了 SMTP_* 用 SMTP；否则用 EMAIL_API_*。
#
# ---- 方式一：SMTP（学校邮箱 / QQ / 163 / 自建）----
# SMTP_SECURE 留空时按端口推断（465 = 隐式 TLS，其余 = STARTTLS）。
# 显式写死 secure=true 是常见错误：587 端口上会直接握手失败。
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# 发件人。多数 SMTP 服务要求它与 SMTP_USER 一致，否则会被拒。
EMAIL_FROM=""

# ---- 方式二：HTTP API（Cloudflare 后面的 MailChannels / Resend / 自建 Worker）----
# 期望的请求形状：
#   POST {EMAIL_API_URL}
#   Authorization: Bearer {EMAIL_API_KEY}
#   {"from":"…","to":"…","subject":"…","text":"…"}
# 字段名不同的服务商，在 src/lib/email/transport.ts 里加一层映射即可。
EMAIL_API_URL=""
EMAIL_API_KEY=""

# ---------------------------------------------------------------- Bangumi OAuth（可选）
#
# 不配也能用：设置页的「个人访问令牌」是完全等价的方式。
# 配了则多一个「用 Bangumi 账号授权登录」按钮（免手动复制令牌）。
#
# ⚠️ 授权失败最常见的原因是 **redirect_uri 与在 Bangumi 登记的不一致**。
#    BGM 要求逐字符相同（含端口与结尾斜杠）。因此这里必须写**固定值**，
#    不要留空 —— 留空会按访问者的 host 推导，用局域网 IP 打开时就与登记值不符。
#
# 在 https://bgm.tv/dev/app 创建应用，回调地址填与本行完全一致的值。
BGM_CLIENT_ID=""
BGM_CLIENT_SECRET=""
BGM_REDIRECT_URI="http://localhost:3100/api/auth/bgm/callback"
