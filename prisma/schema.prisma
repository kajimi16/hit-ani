// hit-ani 数据模型
// 设计依据见 docs/PLAN.md 第 4 节。
// 核心边界：Bangumi API 只提供「条目/章节元数据 + 用户自己的收藏与进度」，
// 弹幕、评论、影评均为平台自建（BGM v0 无对应接口，旧版接口已 404）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 学校。`schoolId` 是「只看本校」筛选的根基，注册时由邮箱域名/学号白名单决定。
model School {
  id        String @id
  name      String
  /// 允许注册的邮箱域名，如 ["hit.edu.cn"]
  domains   String[]
  createdAt DateTime @default(now())

  users User[]
}

/// 平台账号。QQ 与 Bangumi 均为「绑定」，不是登录身份本身。
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  studentNo    String?  @unique
  /// scrypt 派生的口令散列，格式 `scrypt$<salt>$<hash>`
  passwordHash String
  /// 学校标识：校内弹幕/评论筛选的根基
  schoolId     String
  nickname     String
  avatarUrl    String?
  /**
   * 是否把站内操作（收藏状态 / 评分 / 短评 / 单集进度）同步写回 Bangumi。
   *
   * **默认关闭**。理由：写上游是**不可撤销**的（会覆盖用户在 Bangumi 上
   * 已有的内容），而用户并不知道本站会替他写。默认开启等于替他做了决定。
   *
   * 用户可以在设置里显式打开 —— 那时他才是在知情的前提下选择同步。
   * 打开前界面会说明「会覆盖你在 Bangumi 上的对应内容」。
   */
  mirrorToBgm Boolean @default(false)

  /// 管理员：可修改共享的抓取源配置。
  /// 通过 `ADMIN_EMAILS` 环境变量在登录时自动授予（见 session.ts）。
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  qqBinding   QqBinding?
  bgmBinding  BgmBinding?
  collections Collection[]
  progress    EpisodeProgress[]
  danmakus    Danmaku[]
  reviews     Review[]
  danmakuReports DanmakuReport[]
  jellyfinConnections JellyfinConnection[]
  /// 我关注的人（单向）
  following   UserFollow[] @relation("follower")
  /// 关注我的人（单向）
  followers   UserFollow[] @relation("followee")

  @@index([schoolId])
}

model QqBinding {
  userId  String   @id
  openId  String   @unique
  unionId String?
  boundAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Bangumi 凭据。两条绑定路径共用本表：
/// - OAuth：`access_token` 7 天有效期，靠 `refreshToken` 续期；
/// - 个人令牌：`personalToken = true`，无 refresh_token，过期需用户重新粘贴。
///
/// `accessToken` 等值为账户级凭据（等同密码），仅服务端读写，**绝不通过 API 回显**。
model BgmBinding {
  userId        String   @id
  bgmUserId     Int      @unique
  bgmUsername   String
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  /// true = 用户自行生成的个人访问令牌，不走 refresh 流程
  personalToken Boolean  @default(false)
  syncedAt      DateTime?
  boundAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Bangumi 条目本地缓存（读业务走本地，BGM 仅作同步源）
model Subject {
  id        Int       @id
  type      Int
  name      String
  nameCn    String?
  summary   String?
  coverUrl  String?
  airDate   DateTime?
  score     Float?
  rank      Int?
  /// 评分人数（BGM `rating.total`）。与 `score` 一起构成「N 人评分」。
  ratingTotal Int?
  /// 1–10 分的评分直方图（BGM `rating.count`），形如 `{"8": 2708, "9": 3111}`。
  ///
  /// 存下来是为了渲染详情页右栏的评分直方图 —— 那是 Animeko 详情页的标志性
  /// 元素，而每次访问都回上游拉一遍评分分布纯属浪费。
  ratingHistogram Json?

  /*
   * Bangumi 全站的收藏人数（`Subject.collection`）。
   *
   * 与本站自己的 `Collection` 计数是两回事：本站是校内小样本，而这里是
   * 「这部番在全网有多热」—— 一个几万人的数字，是判断要不要看的实际依据。
   * 用户明确要求导入它（此前详情页只显示本站的个位数，并附一句「不含
   * Bangumi 全站」，等于没给出任何可参考的流行度）。
   *
   * 字段名对齐 Bangumi 的 `collect` / `doing` / `wish` / `on_hold` / `dropped`，
   * 但用 `Done` 而不是 `Collect` —— 本项目的 `CollectionStatus.Done` 就是「看过」，
   * 两套命名混用会让「3 是看过还是在看」这类映射错误再次发生
   * （见 `src/lib/collection.ts` 开头的警告）。
   */
  bgmWish    Int?
  bgmDoing   Int?
  bgmDone    Int?
  bgmOnHold  Int?
  bgmDropped Int?
  /// 作品标签（BGM `tags` 的 name 列表）。
  ///
  /// 收藏导入时会从 `SlimSubject` 写入；但**直接打开一个未收藏的条目**时
  /// 是空的，由 `enrichSubject` 补上。
  tags      String[]
  cachedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// 详情（完整简介 + 章节）的同步时间。
  ///
  /// `null` 表示**只有轻量数据** —— 来自收藏列表接口内嵌的 `SlimSubject`
  /// （含封面/名称/评分，够渲染列表），但还没拉过详情与章节。
  ///
  /// 这个字段是「访问时获取并缓存」策略的判据：批量导入只写轻量数据，
  /// 用户真正打开条目时才补齐详情，避免为 377 个收藏打出上千次请求。
  detailSyncedAt DateTime?

  /// 制作人员（`/v0/subjects/{id}/persons`）的同步时间。
  ///
  /// 与 `detailSyncedAt` 分开，是因为两者**失败互不影响**：详情与章节拿到了、
  /// 人员接口偶尔超时，不该把整条记录判为「没同步」而在每次访问时重拉全部。
  staffSyncedAt DateTime?

  episodes    Episode[]
  collections Collection[]
  reviews     Review[]
  persons     SubjectPerson[]

  @@index([type, airDate])
}

/// 条目关联的制作人员（导演、脚本、音乐、动画制作…）。
///
/// 与 `Subject` 分表而不是塞进一个 JSON 列：一个条目常有几十个职位，
/// 分表才能按条目一次取全、并在条目删除时级联清理。
model SubjectPerson {
  /// BGM 人员 id。**同一人可以在同一作品里担任多个职位**
  /// （例如「原作」与「脚本」），因此主键必须是「条目 + 人员 + 职位」。
  subjectId Int
  personId  Int
  /// 职位，如「导演」「系列构成」。名称随上游，不做映射 ——
  /// 硬编码职位表会在上游新增/改名时静默丢人。
  relation  String
  name      String
  /// 职业类别（`producer` / `mangaka` / `seiyu` …），用于排序与分组。
  career    String[]
  imageUrl  String?
  /// 上游返回顺序。BGM 已按「重要度」排好，照它渲染即可。
  sort      Int

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([subjectId, personId, relation])
  @@index([subjectId, sort])
}


model Episode {
  id        Int       @id
  subjectId Int
  sort      Float
  ep        Float?
  name      String
  nameCn    String?
  airdate   DateTime?
  duration  String?

  subject  Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  danmakus Danmaku[]
  progress EpisodeProgress[]

  @@index([subjectId, sort])
}

/// 用户收藏。
/// ⚠️ `type` 对齐 BGM `SubjectCollectionType`，**2=看过、3=在看**（顺序反直觉，曾写错）：
/// 1=想看, 2=看过, 3=在看, 4=搁置, 5=抛弃。权威映射见 `src/lib/collection.ts`。
model Collection {
  id        String   @id @default(cuid())
  userId    String
  subjectId Int
  type      Int
  comment   String?
  rating    Int?
  /** 来源：bgm = 从 Bangumi 导入，local = 站内修改 */
  source    String   @default("bgm")
  /**
   * 该收藏在 Bangumi 上是否标记为**私密**。
   *
   * 时光机会把用户的活动展示给同校其他人，而「私密收藏」正是用户明确表示
   * 不想被别人看到的东西。导入时必须把这个标记一并取回来，时光机的查询
   * 才能把 `true` 的排除掉 —— 否则等于替用户公开了他特意设为私密的内容。
   *
   * 默认 `false`：站内自己加的收藏没有这个概念，按公开处理（它们本来就是
   * 在站内产生的行为）。
   */
  isPrivate Boolean  @default(false)
  /**
   * 本地的最后修改时间（Prisma `@updatedAt` 自动维护）。
   *
   * 任何编辑都会刷新它 —— 因此它**不是**「加入收藏的时间」，
   * 按它排序等于按「最近动过」排序。
   */
  updatedAt DateTime @updatedAt

  /**
   * 加入收藏的时间（来自 Bangumi 收藏记录的 `updated_at`）。
   *
   * 为什么不能复用 `updatedAt`：那是 Prisma 自动维护的**本地**修改时间，
   * 改一次评分或评论就会刷新，于是「按加入时间排序」会变成「按最近动过排序」——
   * 那正是用户抱怨排序选项缺失时要的那个语义，用错了等于没修。
   *
   * 可空：站内手动添加的收藏没有上游时间；导入时若上游缺该字段也为空。
   * 排序时用 `nulls: "last"` 让这些条目垫底，而不是混在中间。
   */
  collectedAt DateTime?

  /**
   * 上次看到的位置（毫秒）。用于「继续观看」跳到正确的时间点。
   *
   * ## 为什么放在 `Collection` 而不是 `EpisodeProgress`
   *
   * `EpisodeProgress` 记的是**每一集**的观/未观三元状态（Animeko 的
   * `EpisodeCollectionType`），粒度是集。续播要的是「这一集看到第几秒」——
   * 一条播放位置。放在条目级够用：一部番同一时刻只会在一个位置继续看，
   * 换集时覆盖即可，不必为每集存一行。
   *
   * 可空：从未播放过时为 null（**不是 0** —— 0 表示「从片头继续」，
   * null 表示「没有可续播的位置」，界面据此决定是否显示进度）。
   */
  playbackPositionMs Int?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([subjectId, type])
  @@index([userId, type])
  /// 追番页按「加入时间」排序时走这个索引，避免全表排序
  @@index([userId, collectedAt])
}

/// 单集进度。type: 0未看 1想看 2看过 3抛弃（对齐 BGM EpisodeCollectionType）
model EpisodeProgress {
  id        String   @id @default(cuid())
  userId    String
  episodeId Int
  type      Int
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
}

/// 自建弹幕 —— 平台核心差异化载体。
/// 字段对齐 Animeko 的 DanmakuInfo / DanmakuContent（playTimeMillis/color/text/location）。
model Danmaku {
  id         String   @id @default(cuid())
  episodeId  Int
  userId     String
  /// 冗余存 schoolId，使「只看本校」成为索引命中而非后置过滤
  schoolId   String
  playTimeMs Int
  text       String
  /// RGB，默认白色 0xFFFFFF
  color      Int      @default(16777215)
  /// 0=NORMAL(滚动) 1=TOP 2=BOTTOM，对齐 Animeko DanmakuLocation
  location   Int      @default(0)
  /// 0正常 1屏蔽 2已删除
  status     Int      @default(0)
  /// 弹幕来源：hit-ani 自建 / 未来接入的 dandanplay 等
  serviceId  String   @default("HitAni")
  createdAt  DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports DanmakuReport[]

  @@index([episodeId, playTimeMs])
  @@index([episodeId, schoolId, playTimeMs])
  @@index([userId, createdAt])
}

/// 弹幕举报。
///
/// 为什么需要：弹幕是校内 UGC，上线前必须有举报通道 ——
/// 否则违规内容没人能处理，风险落在运营方（学校）。
/// 同一用户对同一弹幕只能举报一次（唯一约束）。
model DanmakuReport {
  id        String   @id @default(cuid())
  danmakuId String
  reporterId String
  /// 举报理由
  reason    String
  /// 0待处理 1已屏蔽 2已驳回
  status    Int      @default(0)
  createdAt DateTime @default(now())
  handledAt DateTime?

  danmaku  Danmaku @relation(fields: [danmakuId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([danmakuId, reporterId])
  @@index([status, createdAt])
}

/// 外部弹幕的**持久化**缓存。
///
/// 为什么需要落盘（内存 LRU 不够）：
/// - dandanplay 的使用约定明确要求缓存，并会对调用量大的应用限流 ——
///   网关每次重启都全量回源是明确的风险
/// - 内存 LRU 只有 40 集、TTL 5 分钟，重启即全失
///
/// 体积：弹幕 JSON 高度重复，gzip 后 94% 压缩率（0.89MB → 56KB），
/// 1 万集约 0.5GB —— 远小于视频，因此放数据库（内部盘）而非外挂硬盘更合适：
/// 能随其余数据一起备份，也不受外挂盘掉线影响。
model DanmakuCache {
  /// 来源（Animeko / Dandanplay）
  service   String
  /// BGM 的 episodeId
  episodeId Int
  /// gzip 压缩后的弹幕 JSON
  payload   Bytes
  /// 实际存储条数（可能被上限截断）
  count     Int
  /// 截断前的真实条数 —— 界面据此提示「共 N 条，已显示前 M 条」
  total     Int
  fetchedAt DateTime @default(now())

  @@id([service, episodeId])
  /// 按时间清理过期条目
  @@index([fetchedAt])
}

/// 评论 / 影评。kind: 0短评 1长评(影评)
model Review {
  id        String   @id @default(cuid())
  userId    String
  subjectId Int
  kind      Int
  title     String?
  content   String
  rating    Int?
  schoolId  String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, schoolId, createdAt])
  @@index([subjectId, createdAt])
}

/// 媒体源配置。
///
/// ⚠️ 法律边界：本表只存**「如何查找资源」的规则**（URL 模板、CSS 选择器、正则），
/// 不存任何视频文件、种子文件或直链。平台不托管、不分发内容。
/// 资源由部署方自行选择来源并承担相应责任（见 docs/MEDIA.md §6.4）。
model MediaSource {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// `web-selector` | `rss`
  factory     String
  /// 该 factory 对应的配置对象（见 src/lib/media/source-config.ts 的 schema）
  config      Json
  enabled     Boolean  @default(true)
  /// 排序权重，小者优先
  priority    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
}

/// 用户自己的 Jellyfin / Emby 服务器连接。
///
/// 为什么是「用户自己的」：视频字节从该服务器直连浏览器，**不经过本平台**。
/// 平台只保存连接信息用于索引与生成播放地址 —— 因此不承担带宽，也不是内容分发方。
///
/// `accessToken` 是用户在该服务器上的凭据，等同密码：仅服务端读写，**绝不回显**。
model JellyfinConnection {
  id            String   @id @default(cuid())
  userId        String
  /// 展示名，如「宿舍服务器」
  name          String
  /// 服务器地址（已归一化，无尾斜杠）—— **服务端**用它调 API。
  /// 容器部署时通常是内部服务名（如 `http://jellyfin:8096`）。
  baseUrl       String
  /// **浏览器侧**访问地址，用于生成播放 / 封面 URL。
  ///
  /// 为什么必须与服务端地址分开：容器部署时服务端走内部服务名，
  /// 而**学生浏览器解析不了那个名字**（它是 Docker 网络内的）。
  /// 留空则回退用 baseUrl（裸机部署下两者相同）。
  publicBaseUrl String?
  /// Jellyfin 侧的 access token —— 敏感，绝不回显
  accessToken   String
  /// 该 token 所属的 Jellyfin 用户 id
  remoteUserId  String
  /// Jellyfin 侧用户名，仅用于展示
  remoteUserName String
  /// 服务器版本与名称，便于排查
  serverName    String?
  serverVersion String?
  /// 是否允许内网地址（Jellyfin 常在局域网）
  allowPrivateHost Boolean @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 同一用户对同一地址只保留一条
  @@unique([userId, baseUrl])
  @@index([userId])
}

/// Bangumi 站内评论（吐槽箱）的抓取缓存。
///
/// 为什么单独一张表而不是复用 `DanmakuCache`：两者的内容、TTL、来源都不同
/// （弹幕按集缓存、6 小时；评论按条目缓存、同样 6 小时但走 HTML 解析）。
/// 混在一张表里会让查询必须带一个「类型」判别字段，得不偿失。
///
/// `payload` 存 JSON 字符串而不是 Json 列：评论条目里含大量中文与引号，
/// 整体存字符串可以一次性 `JSON.parse`，也避免了 Json 列对形状的隐式约束。
model BgmCommentsCache {
  subjectId Int      @id
  payload   String
  /// BGM 的分页总数 —— 界面要显示「共 N 页」。
  totalPages Int
  fetchedAt DateTime @default(now())
}

/// 关注关系（**单向**）。
///
/// ## 为什么是单向而不是双向好友
///
/// 双向好友需要「申请 → 对方同意」，而本平台**没有通知系统** —— 申请只能
/// 靠对方自己进好友页才发现，实际会被长期搁置。单向关注没有这个死角：
/// 加了立刻能看，对方在「关注我的人」里能看到谁加了他。
///
/// ## 隐私
///
/// 关注**不等于**能看到全部内容：`Collection.isPrivate` 为真的收藏
/// 仍然只有本人可见（与时光机、收藏短评同一套规则）。
/// 关注只是解除了「你完全不认识这个人」的壁垒，不是内容授权。
model UserFollow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  /// 一人对一人只能有一条。
  @@id([followerId, followeeId])
  /// 「我关注的人」按时间倒序查
  @@index([followerId, createdAt])
  /// 「关注我的人」按时间倒序查
  @@index([followeeId, createdAt])
}

/// 注册邮箱验证码。
///
/// ## 为什么存散列而不是明文
///
/// 验证码是**短期凭据**（10 分钟），但仍等同于一次登录机会 —— 数据库若被
/// 读取，明文验证码可以直接用来注册任意校内邮箱。复用 `hashPassword`
/// （同一套 scrypt），与用户口令一个待遇。
///
/// ## 为什么用 (email, purpose) 作主键
///
/// 一个邮箱同一时刻只应有一个有效验证码：重发即覆盖，不留多份有效凭据
/// （否则旧码也能用，等于把爆破面乘以「历史上发过多少次」）。
model EmailVerification {
  email     String
  /// 用途。目前只有 `register`，将来加「找回密码」时可区分。
  purpose   String   @default("register")
  /// scrypt 散列，格式与 `User.passwordHash` 相同。
  codeHash  String
  /// 校验尝试次数。超过上限即作废 —— 否则 6 位数字可被在线穷举。
  attempts  Int      @default(0)
  expiresAt DateTime
  /// 发送时间，用于「N 秒内不可重发」的节流。
  sentAt    DateTime @default(now())
  /// 最近一次发送者的 IP，用于按 IP 限流（防同一人换邮箱轰炸）。
  sentFromIp String?

  @@id([email, purpose])
  @@index([expiresAt])
}
