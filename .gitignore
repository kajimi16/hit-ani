/data/animeko-sources.json

# 弹幕网关的打包产物（由 npm run gateway:build 生成）
/dist

# 数据库备份
*.sql

# 生产实例的管理员口令（不入库）
.alice-credentials

# 开发库口令（不入库）
.dev-db-password
.container-db-password
.jellyfin-credentials

# 选片清单（生成物，且含部署方的库容决策）
data/curation.json
