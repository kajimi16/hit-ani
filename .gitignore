# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files —— 含密钥，绝不入库
.env
.env.local
.env.*.local

# typescript
*.tsbuildinfo

# prisma
/prisma/*.db

