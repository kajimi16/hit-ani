# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files —— 含密钥，绝不入库
.env
.env.local
.env.*.local

# typescript
*.tsbuildinfo

# prisma
/prisma/*.db

# 抓取源清单：部署方自备，不入库（性质同 .env —— 是配置而非代码）
/data/animeko-sources.json

# 弹幕网关的打包产物（由 npm run gateway:build 生成）
/dist

# 数据库备份
*.sql

# 生产实例的管理员口令（不入库）
.alice-credentials

# 开发库口令（不入库）
.dev-db-password
.container-db-password
.jellyfin-credentials

# 选片清单（生成物，且含部署方的库容决策）
data/curation.json

# 临时脚本（一次性排查/造数据用，用完即删）
#
# 加这条是因为**真的发生过**：一个临时会话脚本被 `git add -A` 顺手提交了
# （里面有写死的测试账号口令）。临时脚本通常不会被删干净，
# 而 `git add -A` 不会区分「临时」与「新增」。
tmp-*.ts
tmp-*.tsx
tmp-*.js
tmp-*.py
