{
  "name": "hit-ani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "gateway": "tsx --env-file=.env src/server/danmaku-gateway.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "bgm:types": "openapi-typescript .bgm-v0.yaml -o src/lib/bgm/schema.d.ts",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "bgm:check": "tsx --env-file=.env scripts/bgm-check.ts",
    "bgm:bind-check": "tsx --env-file=.env scripts/bgm-bind-check.ts",
    "import-check": "tsx --env-file=.env scripts/import-check.ts",
    "sources:import": "tsx --env-file=.env scripts/import-sources.ts",
    "sources:probe": "tsx --env-file=.env scripts/probe-chain.ts",
    "dandanplay:check": "tsx --env-file=.env scripts/check-dandanplay.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.3",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "openapi-typescript": "^7.13.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
